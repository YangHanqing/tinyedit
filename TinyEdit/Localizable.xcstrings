          }
        }
      }
    },
    "No translation was returned. Try again or choose another model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No translation was returned. Try again or choose another model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未返回译文，请重试或选择其他模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未傳回譯文，請重試或選擇其他模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳が返されませんでした。再試行するか、別のモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역이 반환되지 않았습니다. 다시 시도하거나 다른 모델을 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde keine Übersetzung zurückgegeben. Versuchen Sie es erneut oder wählen Sie ein anderes Modell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune traduction reçue. Réessayez ou choisissez un autre modèle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recibió traducción. Inténtalo de nuevo o elige otro modelo."
          }
        }
      }
    },
    "The translation was incomplete. Select less text or choose another model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation was incomplete. Select less text or choose another model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "译文不完整，请减少所选文字或选择其他模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "譯文不完整，請減少所選文字或選擇其他模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳が途中で切れました。選択範囲を減らすか、別のモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역이 완성되지 않았습니다. 더 적은 텍스트나 다른 모델을 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung ist unvollständig. Wählen Sie weniger Text oder ein anderes Modell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction est incomplète. Sélectionnez moins de texte ou un autre modèle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción está incompleta. Selecciona menos texto o elige otro modelo."
          }
        }
      }
    },
    "The service returned an invalid Chat Completions response.": {
