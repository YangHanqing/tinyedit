    "Choose a target language different from the source language.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a target language different from the source language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择与源语言不同的目标语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇與來源語言不同的目標語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文と異なる翻訳先の言語を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문과 다른 대상 언어를 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine andere Zielsprache als die Ausgangssprache."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une langue cible différente de la langue source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un idioma de destino diferente del idioma de origen."
          }
        }
      }
    },
    "The original text changed. Copy the translation or open it in a new tab.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original text changed. Copy the translation or open it in a new tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文已发生变化，请复制译文或在新标签页打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原文已變更，請複製譯文或在新分頁開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文が変更されました。翻訳をコピーするか、新しいタブで開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문이 변경되었습니다. 번역을 복사하거나 새 탭에서 여세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Originaltext wurde geändert. Kopieren Sie die Übersetzung oder öffnen Sie sie in einem neuen Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte original a changé. Copiez la traduction ou ouvrez-la dans un nouvel onglet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto original cambió. Copia la traducción o ábrela en una pestaña nueva."
          }
        }
      }
    },
    "Apple translates on device. You may be asked to download language resources.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple translates on device. You may be asked to download language resources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 在设备上翻译，首次使用可能需要下载语言资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 在裝置上翻譯，首次使用可能需要下載語言資源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleはデバイス上で翻訳します。言語リソースのダウンロードが必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple은 기기에서 번역합니다. 언어 리소스 다운로드가 필요할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple übersetzt auf dem Gerät. Möglicherweise müssen Sprachressourcen geladen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple traduit sur l’appareil. Un téléchargement des ressources linguistiques peut être demandé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple traduce en el dispositivo. Puede solicitar la descarga de recursos de idiomas."
          }
        }
      }
    },
    "The selected text will be sent to your configured service. Its usage fees and privacy policy apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected text will be sent to your configured service. Its usage fees and privacy policy apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文字将发送到你配置的服务，费用和隐私政策由该服务决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選文字將傳送到你設定的服務，費用與隱私政策由該服務決定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストは設定済みのサービスに送信されます。そのサービスの料金とプライバシーポリシーが適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트가 설정한 서비스로 전송됩니다. 해당 서비스의 요금과 개인정보 처리방침이 적용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Text wird an den konfigurierten Dienst gesendet. Dessen Gebühren und Datenschutzrichtlinie gelten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné sera envoyé au service configuré. Ses tarifs et sa politique de confidentialité s’appliquent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto seleccionado se enviará al servicio configurado. Se aplican sus tarifas y política de privacidad."
          }
        }
      }
    },
    "Translate into your preferred language. When the original is already in that language, use your second language.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate into your preferred language. When the original is already in that language, use your second language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认翻译成首选语言；原文已经是首选语言时，翻译成第二语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設翻譯成偏好語言；原文已是偏好語言時，翻譯成第二語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先言語に翻訳します。原文がその言語の場合は第二言語を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선호 언어로 번역합니다. 원문이 이미 선호 언어라면 두 번째 언어를 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt in Ihre bevorzugte Sprache. Ist der Originaltext bereits in dieser Sprache, wird die zweite Sprache verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit dans votre langue préférée. Si l’original est déjà dans cette langue, utilise votre seconde langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce a tu idioma preferido. Si el original ya está en ese idioma, utiliza tu segundo idioma."
          }
        }
      }
    },
    "Leave the key field unchanged to keep your saved key. Remove takes effect when you save.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the key field unchanged to keep your saved key. Remove takes effect when you save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不修改密钥栏即可保留已保存的密钥。移除操作在保存后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不修改金鑰欄即可保留已儲存的金鑰。移除操作在儲存後生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー欄を変更しなければ保存済みのキーを保持します。削除は保存時に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 입력란을 변경하지 않으면 저장된 키가 유지됩니다. 제거는 저장할 때 적용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie das Schlüsselfeld unverändert, um den gespeicherten Schlüssel zu behalten. Das Entfernen wird beim Speichern wirksam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne modifiez pas le champ pour conserver la clé enregistrée. La suppression prend effet à l’enregistrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambies el campo para conservar la clave guardada. La eliminación se aplica al guardar."
          }
        }
      }
    },
    "Uses a Chat Completions compatible service. The API key is stored in Keychain for this endpoint. Leave it empty for local services that do not require a key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses a Chat Completions compatible service. The API key is stored in Keychain for this endpoint. Leave it empty for local services that do not require a key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用兼容 Chat Completions 的服务。API Key 按端点保存在钥匙串中。无需密钥的本地服务可留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相容 Chat Completions 的服務。API Key 依端點儲存在鑰匙圈中。無需金鑰的本機服務可留空。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat Completions互換サービスを使います。APIキーはこのエンドポイント用にキーチェーンに保存されます。キー不要のローカルサービスでは空欄にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat Completions 호환 서비스를 사용합니다. API 키는 이 엔드포인트용으로 키체인에 저장됩니다. 키가 필요 없는 로컬 서비스는 비워 두세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet einen Chat Completions-kompatiblen Dienst. Der API-Schlüssel wird für diesen Endpunkt im Schlüsselbund gespeichert. Für lokale Dienste ohne Schlüssel kann das Feld leer bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un service compatible Chat Completions. La clé API est enregistrée dans le trousseau pour cette URL. Laissez vide pour les services locaux sans clé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza un servicio compatible con Chat Completions. La clave API se guarda en el llavero para esta URL. Déjala vacía para servicios locales sin clave."
          }
        }
      }
    },
    "Enter a full HTTPS Chat Completions URL. HTTP is allowed only for localhost.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a full HTTPS Chat Completions URL. HTTP is allowed only for localhost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入完整的 HTTPS Chat Completions 网址。HTTP 仅限本机地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入完整的 HTTPS Chat Completions 網址。HTTP 僅限本機位址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なHTTPS Chat Completions URLを入力してください。HTTPはlocalhostのみ許可されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 HTTPS Chat Completions URL을 입력하세요. HTTP는 로컬 주소에만 허용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine vollständige HTTPS-URL für Chat Completions ein. HTTP ist nur für localhost erlaubt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une URL HTTPS Chat Completions complète. HTTP est autorisé uniquement pour localhost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una URL HTTPS completa de Chat Completions. HTTP solo se permite para localhost."
          }
        }
      }
    },
    "Set the endpoint and model in Settings. Add an API key if your service requires one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the endpoint and model in Settings. Add an API key if your service requires one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中填写端点和模型名称。如果服务需要，请添加 API Key。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在設定中填寫端點與模型名稱。若服務需要，請新增 API Key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でエンドポイントとモデル名を入力してください。必要な場合はAPIキーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 엔드포인트와 모델을 입력하세요. 서비스에서 요구하면 API 키를 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie Endpunkt und Modell in den Einstellungen fest. Fügen Sie bei Bedarf einen API-Schlüssel hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez l’URL et le modèle dans les réglages. Ajoutez une clé API si le service l’exige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la URL y el modelo en Ajustes. Añade una clave API si el servicio la requiere."
          }
        }
      }
    },
    "Could not access the API key in Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access the API key in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问钥匙串中的 API Key。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取鑰匙圈中的 API Key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンのAPIキーにアクセスできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인의 API 키에 접근할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
