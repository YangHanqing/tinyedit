    "The new language takes effect the next time you open TinyEdit. Your tabs and unsaved text are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new language takes effect the next time you open TinyEdit. Your tabs and unsaved text are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新语言将在您下次打开 TinyEdit 时生效。您的标签页和未存储的文本都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新語言會在您下次打開 TinyEdit 時生效。您的標籤頁和尚未儲存的文字都會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語は次回 TinyEdit を開いたときに適用されます。タブと保存していないテキストはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 언어는 다음에 TinyEdit을 열 때 적용됩니다. 탭과 저장하지 않은 텍스트는 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache wird beim nächsten Öffnen von TinyEdit verwendet. Deine Tabs und nicht gesicherter Text bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue sera utilisée à la prochaine ouverture de TinyEdit. Vos onglets et le texte non enregistré sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se aplicará la próxima vez que abras TinyEdit. Tus pestañas y el texto sin guardar se conservan."
          }
        }
      }
    },
