    "Select less text. Translation supports up to 500,000 UTF-16 characters at a time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select less text. Translation supports up to 500,000 UTF-16 characters at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择更少的文字。每次翻译最多支持 500,000 个 UTF-16 字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇更少的文字。每次翻譯最多支援 500,000 個 UTF-16 字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択するテキストを減らしてください。一度に翻訳できるのは最大500,000 UTF-16文字です。"
          }
        },
        "ko": {
          "stringUnit": {
