    "Characters include spaces and line breaks. A combined emoji counts as one character.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Characters include spaces and line breaks. A combined emoji counts as one character."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字符数包含空格和换行，组合表情按一个字符计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "字元數包含空格和換行，組合表情按一個字元計。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字数には空白と改行を含みます。結合された絵文字は1文字として数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 수에는 공백과 줄바꿈이 포함됩니다. 결합된 이모지는 한 문자로 셉니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leerzeichen und Zeilenumbrüche zählen mit. Ein zusammengesetztes Emoji zählt als ein Zeichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces et les sauts de ligne sont comptés. Un emoji composé compte pour un caractère."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se incluyen espacios y saltos de línea. Un emoji combinado cuenta como un carácter."
