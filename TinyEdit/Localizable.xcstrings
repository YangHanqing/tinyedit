    },
    "Your changes will be lost if you don’t save them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes will be lost if you don’t save them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不存储，您的更改将会丢失。"
