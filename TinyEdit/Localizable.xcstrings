          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Salir sin guardar los datos de recuperación?"
          }
        }
      }
    },
    "TinyEdit could not write your unsaved text to disk. Quitting now can lose recent edits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit could not write your unsaved text to disk. Quitting now can lose recent edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit 无法将未存储的文本写入磁盘。现在退出可能会丢失最近的编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit 無法將未儲存的文字寫入磁碟。現在結束可能會失去最近的編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit は未保存のテキストをディスクに書き込めませんでした。今終了すると、最近の編集が失われることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit이 저장되지 않은 텍스트를 디스크에 쓰지 못했습니다. 지금 종료하면 최근 편집이 손실될 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit konnte den nicht gesicherten Text nicht schreiben. Beim Beenden können kürzliche Änderungen verloren gehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit n’a pas pu écrire le texte non enregistré sur le disque. Quitter maintenant peut faire perdre les modifications récentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TinyEdit no ha podido escribir el texto sin guardar. Salir ahora puede perder los cambios recientes."
          }
        }
      }
    },
    "Quit Anyway": {
      "localizations": {
