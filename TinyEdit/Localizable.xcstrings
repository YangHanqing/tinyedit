    "Partial translation. Continue to finish before replacing the original.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial translation. Continue to finish before replacing the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前是部分译文。继续完成后才能替换原文。"
