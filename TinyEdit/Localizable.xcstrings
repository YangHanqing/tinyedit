    "Thinking controls vary by service. Use its documented format, or Service Default if unsupported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking controls vary by service. Use its documented format, or Service Default if unsupported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不同服务的思考参数不同，请按服务文档选择。不支持时使用“跟随服务默认”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不同服務的思考參數不同，請依服務文件選擇。不支援時使用「跟隨服務預設」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思考パラメータはサービスによって異なります。サービスの文書に従って選択し、非対応の場合は既定値を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사고 매개변수는 서비스마다 다릅니다. 서비스 문서에 따라 선택하고 지원되지 않으면 서비스 기본값을 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denkparameter unterscheiden sich je nach Dienst. Wählen Sie das dokumentierte Format oder den Dienststandard, wenn nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres varient selon le service. Utilisez le format documenté ou la valeur par défaut si non pris en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los parámetros varían según el servicio. Usa el formato documentado o el predeterminado si no se admite."
          }
        }
      }
    },
