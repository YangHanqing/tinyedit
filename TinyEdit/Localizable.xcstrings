    "Optional style or terminology preferences, such as formal tone or Korean honorifics. Applies only to Custom Model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional style or terminology preferences, such as formal tone or Korean honorifics. Applies only to Custom Model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的语气或术语偏好，例如正式语气或韩语敬语，仅适用于自定义模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選的語氣或術語偏好，例如正式語氣或韓語敬語，僅適用於自訂模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文体や用語の希望を任意で指定できます（丁寧な表現や韓国語の敬語など）。カスタムモデルにのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격식 있는 어조나 한국어 존댓말 등 문체나 용어 선호를 지정할 수 있습니다. 사용자 지정 모델에만 적용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Vorgaben zu Stil oder Begriffen, etwa formeller Ton oder koreanische Höflichkeitsformen. Gilt nur für eigene Modelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférences facultatives de style ou de terminologie, comme un ton formel ou les formes honorifiques coréennes. Uniquement pour le modèle personnalisé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferencias opcionales de estilo o terminología, como tono formal o formas honoríficas coreanas. Solo para el modelo personalizado."
          }
        }
      }
    },
    "Optional style or terminology preferences. Changes here apply to this translation only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional style or terminology preferences. Changes here apply to this translation only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的语气或术语偏好。这里的修改仅用于本次翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選的語氣或術語偏好。此處的修改僅用於本次翻譯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文体や用語の希望を任意で指定できます。ここでの変更は今回の翻訳にのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문체나 용어 선호를 지정할 수 있습니다. 여기서 변경한 내용은 이번 번역에만 적용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Vorgaben zu Stil oder Begriffen. Änderungen hier gelten nur für diese Übersetzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférences facultatives de style ou de terminologie. Les modifications ici ne concernent que cette traduction."
          }
        },
        "es": {
