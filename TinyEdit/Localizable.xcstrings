    "Plain HTTP is sent only to local addresses. Use https:// for this server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain HTTP is sent only to local addresses. Use https:// for this server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明文 HTTP 只会发送到本地地址，请为此服务器使用 https://。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明文 HTTP 只會傳送到本機位址，請為此伺服器使用 https://。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されていない HTTP はローカルアドレスにのみ送信します。このサーバには https:// を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화되지 않은 HTTP는 로컬 주소로만 보냅니다. 이 서버에는 https://를 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsseltes HTTP wird nur an lokale Adressen gesendet. Verwende https:// für diesen Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le HTTP non chiffré n’est envoyé qu’aux adresses locales. Utilisez https:// pour ce serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El HTTP sin cifrar solo se envía a direcciones locales. Usa https:// para este servidor."
          }
        }
      }
    },
