    "Recognize document structure and tables": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognize document structure and tables"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别文档结构和表格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辨識文件結構與表格"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書構造と表を認識"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 구조 및 표 인식"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentstruktur und Tabellen erkennen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaître la structure des documents et les tableaux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocer la estructura de documentos y tablas"
          }
        }
      }
    },
    "Document and table recognition requires macOS 26 or later. Tables are inserted as Markdown; the first row becomes the header.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document and table recognition requires macOS 26 or later. Tables are inserted as Markdown; the first row becomes the header."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档和表格识别需要 macOS 26 或更高版本。表格以 Markdown 格式插入，首行作为表头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件與表格辨識需要 macOS 26 或更新版本。表格以 Markdown 格式插入，第一列作為標題列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書と表の認識には macOS 26 以降が必要です。表は Markdown 形式で挿入され、最初の行が見出しになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 및 표 인식에는 macOS 26 이상이 필요합니다. 표는 Markdown 형식으로 삽입되며 첫 행은 머리글이 됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dokument- und Tabellenerkennung erfordert macOS 26 oder neuer. Tabellen werden als Markdown eingefügt; die erste Zeile wird zur Kopfzeile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance des documents et tableaux nécessite macOS 26 ou ultérieur. Les tableaux sont insérés en Markdown ; la première ligne devient l’en-tête."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de documentos y tablas requiere macOS 26 o posterior. Las tablas se insertan en Markdown; la primera fila se convierte en el encabezado."
          }
        }
      }
    },
    "First recognition or model loading may take longer. Please wait…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First recognition or model loading may take longer. Please wait…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次识别或模型加载可能耗时较长，请稍候…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次辨識或模型載入可能需要較長時間，請稍候…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回の認識やモデルの読み込みには時間がかかる場合があります。お待ちください…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최초 인식 또는 모델 로딩에는 시간이 더 걸릴 수 있습니다. 잠시 기다려 주세요…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Erkennung oder das Laden des Modells kann länger dauern. Bitte warten…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première reconnaissance ou le chargement du modèle peut prendre plus de temps. Veuillez patienter…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer reconocimiento o la carga del modelo puede tardar más. Espera un momento…"
          }
        }
      }
    },
