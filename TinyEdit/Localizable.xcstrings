    "Suggestions leave the text unchanged until you apply them. Text tools remain available in the Tools menu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions leave the text unchanged until you apply them. Text tools remain available in the Tools menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用建议前不会修改文本。关闭建议后，仍可在“工具”菜单中使用文本工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用建議前不會修改文字。關閉建議後，仍可在「工具」選單中使用文字工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案を適用するまでテキストは変更されません。テキストツールは「ツール」メニューから引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안을 적용하기 전에는 텍스트가 변경되지 않습니다. 텍스트 도구는 도구 메뉴에서 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge ändern den Text erst beim Anwenden. Textwerkzeuge bleiben im Menü „Werkzeuge“ verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions ne modifient le texte que lorsque vous les appliquez. Les outils de texte restent disponibles dans le menu Outils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias no modifican el texto hasta que las apliques. Las herramientas de texto siguen disponibles en el menú Herramientas."
          }
        }
      }
    }
  },
  "version": "1.0"
