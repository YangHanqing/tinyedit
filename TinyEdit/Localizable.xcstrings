    "Pasting a curl command shows the request it describes with a Send button. Nothing is sent until you click Send.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasting a curl command shows the request it describes with a Send button. Nothing is sent until you click Send."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 curl 命令时，会显示它描述的请求和“发送”按钮。点击“发送”之前不会发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 curl 指令時，會顯示它描述的請求和「傳送」按鈕。按下「傳送」之前不會傳送任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "curl コマンドをペーストすると、そのリクエストの内容と「送信」ボタンが表示されます。「送信」をクリックするまで何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "curl 명령을 붙여넣으면 해당 요청과 보내기 버튼이 표시됩니다. 보내기를 클릭하기 전에는 아무것도 전송되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Einfügen eines curl-Befehls werden die beschriebene Anfrage und eine Schaltfläche „Senden“ angezeigt. Erst ein Klick auf „Senden“ schickt etwas ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller une commande curl affiche la requête qu’elle décrit avec un bouton Envoyer. Rien n’est envoyé avant que vous cliquiez sur Envoyer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pegar un comando curl se muestra la solicitud que describe con un botón Enviar. No se envía nada hasta que haces clic en Enviar."
          }
        }
      }
    },
