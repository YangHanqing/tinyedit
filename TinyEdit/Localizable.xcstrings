    "Markdown and Diff keep trailing whitespace: it is a line break in Markdown and part of a diff's blank lines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown and Diff keep trailing whitespace: it is a line break in Markdown and part of a diff's blank lines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 和 Diff 保留行尾空白：它在 Markdown 中表示换行，在 Diff 中是空白行的一部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 和 Diff 保留行尾空白：它在 Markdown 中代表換行，在 Diff 中是空白行的一部分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown と Diff では行末の空白を残します。Markdown では改行、Diff では空行の一部だからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown과 Diff는 줄 끝 공백을 유지합니다. Markdown에서는 줄바꿈이고 Diff에서는 빈 줄의 일부입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown und Diff behalten Leerzeichen am Zeilenende: In Markdown sind sie ein Zeilenumbruch, in einem Diff Teil der Leerzeilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown et Diff conservent les espaces en fin de ligne : c’est un saut de ligne en Markdown et une partie des lignes vides d’un diff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown y Diff conservan los espacios al final de línea: en Markdown son un salto de línea y en un diff forman parte de las líneas en blanco."
          }
        }
      }
    },
