    "Preview shortened. Copy and Open in New Tab include the full available text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview shortened. Copy and Open in New Tab include the full available text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览已缩短。复制和在新标签页打开会包含当前完整内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽已縮短。複製和在新分頁開啟會包含目前完整內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを省略しています。コピーと新しいタブで開く操作には、現在の全文が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기가 축약되었습니다. 복사와 새 탭에서 열기에는 현재 전체 내용이 포함됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau ist gekürzt. Kopieren und Öffnen in einem neuen Tab enthalten den gesamten verfügbaren Text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu abrégé. Copier et Ouvrir dans un nouvel onglet incluent tout le texte disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa abreviada. Copiar y Abrir en una pestaña nueva incluyen todo el texto disponible."
          }
        }
      }
    },
    "This part exceeds the model's capacity. Reduce the extra instructions or choose another model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part exceeds the model's capacity. Reduce the extra instructions or choose another model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一段超出了模型容量。请缩短额外要求或选择其他模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一段超出模型容量。請縮短額外要求或選擇其他模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この部分はモデルの容量を超えています。追加の指示を短くするか、別のモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 부분은 모델의 용량을 초과합니다. 추가 지침을 줄이거나 다른 모델을 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Teil überschreitet die Modellkapazität. Kürzen Sie die zusätzlichen Anweisungen oder wählen Sie ein anderes Modell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette partie dépasse la capacité du modèle. Réduisez les consignes supplémentaires ou choisissez un autre modèle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta parte supera la capacidad del modelo. Reduce las instrucciones adicionales o elige otro modelo."
          }
        }
      }
    },
    "Translation timed out. Completed parts are kept; continue to retry this part.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation timed out. Completed parts are kept; continue to retry this part."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译超时。已完成的段落已保留，点击继续可重试当前段落。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯逾時。已完成的段落已保留，點擊繼續可重試目前段落。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳がタイムアウトしました。完了した部分は保持されています。続けてこの部分を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 시간이 초과되었습니다. 완료된 부분은 유지됩니다. 계속하기를 눌러 이 부분을 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Übersetzung. Fertige Teile bleiben erhalten; setzen Sie fort, um diesen Teil erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction a expiré. Les parties terminées sont conservées ; continuez pour réessayer cette partie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción agotó el tiempo. Se conservan las partes completadas; continúa para reintentar esta parte."
          }
        }
      }
    },
    "Keep extra translation instructions within 2,000 UTF-16 characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep extra translation instructions within 2,000 UTF-16 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额外翻译要求请控制在 2,000 个 UTF-16 字符以内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
