    "Sends a short sample request using these settings. Does not save settings or send editor content.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a short sample request using these settings. Does not save settings or send editor content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前设置发送短句测试，不保存设置，不发送编辑器内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前設定傳送短句測試，不儲存設定，不傳送編輯器內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の設定で短いサンプルを送信します。設定の保存やエディタ内容の送信は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 설정으로 짧은 샘플을 전송합니다. 설정을 저장하거나 편집기 내용을 보내지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine kurze Beispielanfrage mit diesen Einstellungen. Speichert keine Einstellungen und sendet keinen Editorinhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
