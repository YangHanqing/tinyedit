        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳は未完了です。原文を置換するには翻訳を続けて完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부만 번역되었습니다. 번역을 완료해야 원문을 바꿀 수 있습니다."
