    "Quit without saving recovery data?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit without saving recovery data?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要退出而不存储恢复数据吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要結束而不儲存回復資料嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元データを保存せずに終了しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
