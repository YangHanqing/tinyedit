    "Apple Translation does not support this language pair. Choose another language or change the translation service in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation does not support this language pair. Choose another language or change the translation service in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 系统翻译不支持这组语言，请选择其他语言或在设置中更换翻译服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 系統翻譯不支援這組語言，請選擇其他語言或在設定中更換翻譯服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの翻訳はこの言語の組み合わせに対応していません。別の言語を選ぶか、設定で翻訳サービスを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 번역이 이 언어 조합을 지원하지 않습니다. 다른 언어를 선택하거나 설정에서 번역 서비스를 변경하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple unterstützt dieses Sprachpaar nicht. Wählen Sie eine andere Sprache oder ändern Sie den Übersetzungsdienst in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ne prend pas en charge cette paire de langues. Choisissez une autre langue ou changez le service de traduction dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no admite este par de idiomas. Elige otro idioma o cambia el servicio de traducción en Ajustes."
          }
        }
      }
    },
